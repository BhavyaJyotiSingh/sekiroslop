# Colosseum 3D Client Environment Variables
# Copy to client/.env.local for local overrides, or set VITE_SERVER_URL in Vercel.

# WebSocket (wss://) or HTTPS URL of your deployed Colyseus multiplayer server.
# Leave empty during local or LAN play so the client auto-connects to ws://<current-host>:2567.
# Production example:
# VITE_SERVER_URL=wss://sekiroslop.up.railway.app
VITE_SERVER_URL=
