# Colosseum Multiplayer Server Environment Variables
# Copy to server/.env for local overrides (never commit real .env files).

# Port for HTTP (/health) and WebSocket (Colyseus) traffic.
# Cloud hosts (Render, Railway, Fly.io) inject PORT automatically.
PORT=2567

# Bind address. 0.0.0.0 allows connections from localhost, LAN peers, and container proxies.
HOST=0.0.0.0

# Allowed browser origins for CORS (comma-separated URLs, or * to allow all origins).
# Example: CORS_ORIGIN=https://your-game.vercel.app,http://localhost:5173
CORS_ORIGIN=*

# Runtime environment: development | production
NODE_ENV=development
